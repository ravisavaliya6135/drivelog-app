# ==============================================================================
# DriveLog Client-Side Environment Variables (Vite)
# ==============================================================================
# These variables are exposed to the browser bundle (prefixed with VITE_).
# NEVER put secret keys or webhook signing secrets here.

# Your Supabase Project URL (e.g., https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Public Anonymous Key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ==============================================================================
# Supabase Edge Functions & Stripe Server-Side Secrets (Deno / Supabase Secrets)
# ==============================================================================
# Set these in your Supabase Dashboard: Settings > Secrets OR via CLI:
# supabase secrets set STRIPE_SECRET_KEY=sk_test_...
#
# STRIPE_SECRET_KEY=sk_live_... (or sk_test_...)
# STRIPE_WEBHOOK_SECRET=whsec_...
# APP_URL=https://drivelog-app.vercel.app
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
